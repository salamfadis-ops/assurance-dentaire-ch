# Une méthode d’envoi au moins est requise en production.
RESEND_API_KEY=
LEADS_TO_EMAIL=contact@vyda.ch
LEADS_FROM_EMAIL=Assurance Dentaire <leads@assurance-dentaire.ch>

# Alternative à Resend : URL d’un webhook CRM sécurisé.
LEADS_WEBHOOK_URL=

# Stockage privé Vercel Blob. Créer un store privé et le connecter au projet.
BLOB_READ_WRITE_TOKEN=
# Alternative recommandée sur Vercel avec OIDC, selon la configuration du store.
BLOB_STORE_ID=
DOCUMENT_MAX_SIZE_MB=10
LEAD_DOCUMENT_RETENTION_DAYS=30
DOCUMENT_LINK_TTL_HOURS=72
CRON_SECRET=

# Rendez-vous facultatif. Le bouton est masqué si la variable est absente.
NEXT_PUBLIC_CALENDLY_URL=

# Suivi Google Ads facultatif.
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_TARGET=
